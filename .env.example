# Banco (ou DATABASE_URL=postgresql://user:pass@host/db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=Dados_RFB
DB_SCHEMA=cnpj

# Fonte dos ZIPs: webdav (Nextcloud da RFB) ou index (listagem HTTP simples)
RFB_SOURCE=webdav
RFB_BASE_URL=https://arquivos.receitafederal.gov.br
RFB_SHARE_TOKEN=YggdBLfdninEJX9
# RFB_SOURCE=index
# RFB_BASE_URL=https://dadosabertos.rfb.gov.br/CNPJ/dados_abertos_cnpj

# Onde ficam os ZIPs oficiais baixados
DATA_DIR=./data/zips
RFB_KEEP_ZIPS=1

# Polidez com o servidor e paralelismo do banco
RFB_REQUEST_INTERVAL=1.0
RFB_DOWNLOAD_CONCURRENCY=2
RFB_WORKERS=4
